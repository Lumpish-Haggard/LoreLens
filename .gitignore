# Dependencies
node_modules/
package-lock.json
yarn.lock
pnpm-lock.yaml

# Local lorepacks — these are personal, per-novel, and often large.
# Share them via a Gist or Release, not the repo.
*.lorepack.json
!example.lorepack.json
!tests/fixtures/*.lorepack.json

# Test + build output
tests/.out/
.chrome-profile/

# Editors / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# Throwaway preview pages used while eyeballing a visual change
tests/.*.html

# Bug-report screenshots. Kept locally so they can be looked at, never
# committed: they are photographs of a page of a copyrighted novel, and this
# repository is public. Attach them to an issue instead, cropped to the part
# that shows the problem.
assets/bug-reports/
